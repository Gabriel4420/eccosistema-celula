generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CellStatus {
  FORMING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ReportStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  RETURNED
  CANCELED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionRevokedReason {
  ROTATED
  LOGOUT
  PASSWORD_CHANGED
  TOKEN_REUSE
  USER_INACTIVE
}

model Church {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(160)
  slug                  String                 @unique(map: "churches_slug_key") @db.VarChar(100)
  email                 String?                @db.VarChar(320)
  phone                 String?                @db.VarChar(32)
  addressLine           String?                @map("address_line") @db.VarChar(200)
  addressNumber         String?                @map("address_number") @db.VarChar(30)
  addressComplement     String?                @map("address_complement") @db.VarChar(120)
  neighborhood          String?                @db.VarChar(120)
  city                  String?                @db.VarChar(120)
  state                 String?                @db.VarChar(2)
  postalCode            String?                @map("postal_code") @db.VarChar(16)
  country               String                 @default("BR") @db.Char(2)
  timezone              String                 @default("America/Sao_Paulo") @db.VarChar(64)
  weekStartsOn          DayOfWeek              @default(SUNDAY) @map("week_starts_on")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  users                 User[]
  roles                 Role[]
  userRoles             UserRole[]
  supervisorAssignments SupervisorAssignment[]
  cells                 Cell[]
  people                Person[]
  cellMemberships       CellMembership[]
  meetings              Meeting[]
  meetingAttendances    MeetingAttendance[]
  meetingVisitors       MeetingVisitor[]
  meetingReports        MeetingReport[]
  auditLogs             AuditLog[]
  sessions              Session[]
  idempotencyRequests   IdempotencyRequest[]
  reportExports         ReportExport[]
  churchSettings        ChurchSettings?

  @@index([deletedAt], map: "churches_deleted_at_idx")
  @@map("churches")
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  churchId                String                 @map("church_id") @db.Uuid
  firstName               String                 @map("first_name") @db.VarChar(100)
  lastName                String                 @map("last_name") @db.VarChar(100)
  email                   String                 @db.VarChar(320)
  passwordHash            String                 @map("password_hash") @db.VarChar(255)
  profilePhoto            Bytes?                 @map("profile_photo")
  profilePhotoContentType String?                @map("profile_photo_content_type") @db.VarChar(32)
  profilePhotoUpdatedAt   DateTime?              @map("profile_photo_updated_at") @db.Timestamptz(3)
  status                  UserStatus
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?              @map("deleted_at") @db.Timestamptz(3)
  church                  Church                 @relation(fields: [churchId], references: [id], onDelete: Restrict)
  userRoles               UserRole[]
  supervisedAssignments   SupervisorAssignment[] @relation("AssignmentSupervisor")
  leaderAssignments       SupervisorAssignment[] @relation("AssignmentLeader")
  ledCells                Cell[]                 @relation("CellLeader")
  traineeCells            Cell[]                 @relation("CellTraineeLeader")
  submittedReports        MeetingReport[]
  auditLogs               AuditLog[]
  sessions                Session[]
  idempotencyRequests     IdempotencyRequest[]
  exportedReports         ReportExport[]
  preferences             UserPreferences?

  @@unique([id, churchId], map: "users_id_church_id_key")
  @@unique([churchId, email], map: "users_church_id_email_key")
  @@index([churchId, status], map: "users_church_id_status_idx")
  @@index([churchId, deletedAt], map: "users_church_id_deleted_at_idx")
  @@index([churchId, lastName, firstName, id], map: "users_church_name_id_idx")
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_last_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  churchId  String     @map("church_id") @db.Uuid
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)
  church    Church     @relation(fields: [churchId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([id, churchId], map: "roles_id_church_id_key")
  @@unique([churchId, name], map: "roles_church_id_name_key")
  @@index([churchId, deletedAt], map: "roles_church_id_deleted_at_idx")
  @@map("roles")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  churchId  String    @map("church_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  church    Church    @relation(fields: [churchId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId, churchId], references: [id, churchId], onDelete: Restrict)
  role      Role      @relation(fields: [roleId, churchId], references: [id, churchId], onDelete: Restrict)

  @@unique([churchId, userId, roleId], map: "user_roles_church_user_role_key")
  @@index([userId], map: "user_roles_user_id_idx")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([churchId, deletedAt], map: "user_roles_church_id_deleted_at_idx")
  @@index([churchId, roleId, deletedAt], map: "user_roles_church_role_deleted_idx")
  @@map("user_roles")
}

model SupervisorAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  churchId     String    @map("church_id") @db.Uuid
  supervisorId String    @map("supervisor_id") @db.Uuid
  leaderId     String    @map("leader_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  church       Church    @relation(fields: [churchId], references: [id], onDelete: Restrict)
  supervisor   User      @relation("AssignmentSupervisor", fields: [supervisorId, churchId], references: [id, churchId], onDelete: Restrict)
  leader       User      @relation("AssignmentLeader", fields: [leaderId, churchId], references: [id, churchId], onDelete: Restrict)

  @@unique([churchId, supervisorId, leaderId], map: "supervisor_assignments_church_supervisor_leader_key")
  @@index([supervisorId], map: "supervisor_assignments_supervisor_id_idx")
  @@index([leaderId], map: "supervisor_assignments_leader_id_idx")
  @@index([churchId, deletedAt], map: "supervisor_assignments_church_deleted_at_idx")
  @@index([churchId, supervisorId, deletedAt, leaderId], map: "supervisor_assignments_church_supervisor_deleted_leader_idx")
  @@map("supervisor_assignments")
}

model Cell {
  id              String           @id @default(uuid()) @db.Uuid
  churchId        String           @map("church_id") @db.Uuid
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(160)
  status          CellStatus
  leaderId        String?          @map("leader_id") @db.Uuid
  traineeLeaderId String?          @map("trainee_leader_id") @db.Uuid
  meetingDay      DayOfWeek        @map("meeting_day")
  meetingTime     DateTime         @map("meeting_time") @db.Time(0)
  address         String           @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  church          Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  leader          User?            @relation("CellLeader", fields: [leaderId, churchId], references: [id, churchId], onDelete: Restrict)
  traineeLeader   User?            @relation("CellTraineeLeader", fields: [traineeLeaderId, churchId], references: [id, churchId], onDelete: Restrict)
  memberships     CellMembership[]
  meetings        Meeting[]

  @@unique([id, churchId], map: "cells_id_church_id_key")
  @@unique([churchId, code], map: "cells_church_id_code_key")
  @@index([churchId, status], map: "cells_church_id_status_idx")
  @@index([leaderId], map: "cells_leader_id_idx")
  @@index([traineeLeaderId], map: "cells_trainee_leader_id_idx")
  @@index([churchId, deletedAt], map: "cells_church_id_deleted_at_idx")
  @@index([churchId, deletedAt, status, name, id], map: "cells_church_deleted_status_name_idx")
  @@index([churchId, leaderId, deletedAt], map: "cells_church_leader_deleted_idx")
  @@index([churchId, traineeLeaderId, deletedAt], map: "cells_church_trainee_deleted_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "cells_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "cells_code_trgm_idx")
  @@map("cells")
}

model Person {
  id                 String              @id @default(uuid()) @db.Uuid
  churchId           String              @map("church_id") @db.Uuid
  fullName           String              @map("full_name") @db.VarChar(200)
  phone              String?             @db.VarChar(32)
  email              String?             @db.VarChar(320)
  birthDate          DateTime?           @map("birth_date") @db.Date
  gender             String?             @db.VarChar(50)
  observations       String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  church             Church              @relation(fields: [churchId], references: [id], onDelete: Restrict)
  memberships        CellMembership[]
  meetingAttendances MeetingAttendance[]
  meetingVisits      MeetingVisitor[]    @relation("MeetingVisitorPerson")
  invitedVisits      MeetingVisitor[]    @relation("MeetingVisitorInviter")

  @@unique([id, churchId], map: "people_id_church_id_key")
  @@index([churchId, phone], map: "people_church_id_phone_idx")
  @@index([churchId, email], map: "people_church_id_email_idx")
  @@index([churchId, fullName, birthDate], map: "people_church_name_birth_date_idx")
  @@index([churchId, deletedAt], map: "people_church_id_deleted_at_idx")
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "people_full_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "people_phone_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "people_email_trgm_idx")
  @@map("people")
}

model CellMembership {
  id        String           @id @default(uuid()) @db.Uuid
  churchId  String           @map("church_id") @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  cellId    String           @map("cell_id") @db.Uuid
  status    MembershipStatus
  joinedAt  DateTime         @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime?        @map("left_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)
  church    Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  person    Person           @relation(fields: [personId, churchId], references: [id, churchId], onDelete: Restrict)
  cell      Cell             @relation(fields: [cellId, churchId], references: [id, churchId], onDelete: Restrict)

  @@index([churchId, cellId, status], map: "cell_memberships_church_cell_status_idx")
  @@index([churchId, personId, status], map: "cell_memberships_church_person_status_idx")
  @@index([cellId], map: "cell_memberships_cell_id_idx")
  @@index([personId], map: "cell_memberships_person_id_idx")
  @@index([churchId, deletedAt], map: "cell_memberships_church_deleted_at_idx")
  @@map("cell_memberships")
}

model Meeting {
  id                 String              @id @default(uuid()) @db.Uuid
  churchId           String              @map("church_id") @db.Uuid
  cellId             String              @map("cell_id") @db.Uuid
  meetingDate        DateTime            @map("meeting_date") @db.Date
  status             MeetingStatus
  cancellationReason String?             @map("cancellation_reason") @db.VarChar(1000)
  attendanceRevision Int                 @default(0) @map("attendance_revision")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  church             Church              @relation(fields: [churchId], references: [id], onDelete: Restrict)
  cell               Cell                @relation(fields: [cellId, churchId], references: [id, churchId], onDelete: Restrict)
  attendances        MeetingAttendance[]
  visitors           MeetingVisitor[]
  report             MeetingReport?

  @@unique([id, churchId], map: "meetings_id_church_id_key")
  @@unique([churchId, cellId, meetingDate], map: "meetings_church_cell_date_key")
  @@index([churchId, status, meetingDate], map: "meetings_church_status_date_idx")
  @@index([churchId, deletedAt], map: "meetings_church_deleted_at_idx")
  @@map("meetings")
}

model MeetingAttendance {
  id               String           @id @default(uuid()) @db.Uuid
  churchId         String           @map("church_id") @db.Uuid
  meetingId        String           @map("meeting_id") @db.Uuid
  personId         String           @map("person_id") @db.Uuid
  attendanceStatus AttendanceStatus @map("attendance_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)
  church           Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  meeting          Meeting          @relation(fields: [meetingId, churchId], references: [id, churchId], onDelete: Restrict)
  person           Person           @relation(fields: [personId, churchId], references: [id, churchId], onDelete: Restrict)
  visitor          MeetingVisitor?

  @@unique([churchId, meetingId, personId], map: "meeting_attendances_church_meeting_person_key")
  @@index([churchId, meetingId, attendanceStatus], map: "meeting_attendances_church_meeting_status_idx")
  @@index([personId], map: "meeting_attendances_person_id_idx")
  @@index([churchId, deletedAt], map: "meeting_attendances_church_deleted_at_idx")
  @@map("meeting_attendances")
}

model MeetingVisitor {
  id                String            @id @default(uuid()) @db.Uuid
  churchId          String            @map("church_id") @db.Uuid
  meetingId         String            @map("meeting_id") @db.Uuid
  personId          String            @map("person_id") @db.Uuid
  invitedByPersonId String?           @map("invited_by_person_id") @db.Uuid
  observation       String?           @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  church            Church            @relation(fields: [churchId], references: [id], onDelete: Restrict)
  meeting           Meeting           @relation(fields: [meetingId, churchId], references: [id, churchId], onDelete: Restrict)
  person            Person            @relation("MeetingVisitorPerson", fields: [personId, churchId], references: [id, churchId], onDelete: Restrict)
  invitedBy         Person?           @relation("MeetingVisitorInviter", fields: [invitedByPersonId, churchId], references: [id, churchId], onDelete: Restrict)
  attendance        MeetingAttendance @relation(fields: [churchId, meetingId, personId], references: [churchId, meetingId, personId], onDelete: Restrict)

  @@unique([churchId, meetingId, personId], map: "meeting_visitors_church_meeting_person_key")
  @@index([churchId, meetingId, deletedAt], map: "meeting_visitors_church_meeting_deleted_idx")
  @@index([churchId, personId], map: "meeting_visitors_church_person_idx")
  @@index([churchId, invitedByPersonId], map: "meeting_visitors_church_inviter_idx")
  @@map("meeting_visitors")
}

model MeetingReport {
  id           String       @id @default(uuid()) @db.Uuid
  churchId     String       @map("church_id") @db.Uuid
  meetingId    String       @map("meeting_id") @db.Uuid
  observations String?      @db.Text
  submittedBy  String?      @map("submitted_by") @db.Uuid
  submittedAt  DateTime?    @map("submitted_at") @db.Timestamptz(3)
  status       ReportStatus
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  church       Church       @relation(fields: [churchId], references: [id], onDelete: Restrict)
  meeting      Meeting      @relation(fields: [meetingId, churchId], references: [id, churchId], onDelete: Restrict)
  submitter    User?        @relation(fields: [submittedBy, churchId], references: [id, churchId], onDelete: Restrict)

  @@unique([meetingId, churchId], map: "meeting_reports_meeting_church_key")
  @@index([churchId, status, submittedAt], map: "meeting_reports_church_status_submitted_idx")
  @@index([submittedBy], map: "meeting_reports_submitted_by_idx")
  @@index([churchId, deletedAt], map: "meeting_reports_church_deleted_at_idx")
  @@map("meeting_reports")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.Uuid
  action    String   @db.VarChar(100)
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId, churchId], references: [id, churchId], onDelete: Restrict)

  @@index([churchId, createdAt], map: "audit_logs_church_created_at_idx")
  @@index([churchId, entity, entityId], map: "audit_logs_church_entity_entity_id_idx")
  @@index([churchId, userId, createdAt], map: "audit_logs_church_user_created_at_idx")
  @@map("audit_logs")
}

model Session {
  id                  String                @id @default(uuid()) @db.Uuid
  churchId            String                @map("church_id") @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  tokenHash           String                @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(64)
  familyId            String                @map("family_id") @db.Uuid
  expiresAt           DateTime              @map("expires_at") @db.Timestamptz(3)
  lastUsedAt          DateTime?             @map("last_used_at") @db.Timestamptz(3)
  revokedAt           DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason       SessionRevokedReason? @map("revoked_reason")
  replacedBySessionId String?               @unique(map: "sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  church              Church                @relation(fields: [churchId], references: [id], onDelete: Restrict)
  user                User                  @relation(fields: [userId, churchId], references: [id, churchId], onDelete: Restrict)
  replacedBy          Session?              @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            Session?              @relation("SessionRotation")

  @@unique([id, churchId], map: "sessions_id_church_id_key")
  @@index([churchId], map: "sessions_church_id_idx")
  @@index([userId], map: "sessions_user_id_idx")
  @@index([familyId], map: "sessions_family_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@index([userId, revokedAt], map: "sessions_user_id_revoked_at_idx")
  @@index([churchId, userId], map: "sessions_church_id_user_id_idx")
  @@map("sessions")
}

model IdempotencyRequest {
  id          String   @id @default(uuid()) @db.Uuid
  churchId    String   @map("church_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  operation   String   @db.VarChar(100)
  key         String   @db.Uuid
  requestHash String   @map("request_hash") @db.VarChar(64)
  resourceId  String?  @map("resource_id") @db.Uuid
  result      Json
  status      String   @default("COMPLETED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorId, churchId], references: [id, churchId], onDelete: Restrict)

  @@unique([churchId, actorId, operation, key], map: "idempotency_requests_church_actor_operation_key_key")
  @@index([churchId, createdAt], map: "idempotency_requests_church_created_at_idx")
  @@index([expiresAt], map: "idempotency_requests_expires_at_idx")
  @@map("idempotency_requests")
}

model ReportExport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId   String   @map("church_id") @db.Uuid
  exportedBy String   @map("exported_by") @db.Uuid
  reportType String   @map("report_type") @db.VarChar(50)
  format     String   @db.VarChar(10)
  scope      Json     @default("{}")
  rowCount   Int      @default(0) @map("row_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  church   Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  exporter User   @relation(fields: [exportedBy], references: [id], onDelete: Restrict)

  @@index([churchId, createdAt], map: "report_exports_church_created_at_idx")
  @@index([churchId, reportType], map: "report_exports_church_type_idx")
  @@index([exportedBy], map: "report_exports_exported_by_idx")
  @@map("report_exports")
}

model ChurchSettings {
  id                  String    @id @default(uuid()) @db.Uuid
  churchId            String    @map("church_id") @db.Uuid
  reportDeadlineHours Int       @default(48) @map("report_deadline_hours")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  church              Church    @relation(fields: [churchId], references: [id], onDelete: Restrict)

  @@unique([churchId], map: "church_settings_church_id_key")
  @@unique([id, churchId], map: "church_settings_id_church_id_key")
  @@index([churchId, deletedAt], map: "church_settings_church_id_deleted_at_idx")
  @@map("church_settings")
}

model UserPreferences {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  churchId        String    @map("church_id") @db.Uuid
  language        String    @default("pt-BR") @db.VarChar(10)
  displayTimezone String?   @map("display_timezone") @db.VarChar(64)
  dateFormat      String    @default("dd/MM/yyyy") @map("date_format") @db.VarChar(16)
  theme           String    @default("system") @db.VarChar(10)
  accessibilityContrast String @default("system") @map("accessibility_contrast") @db.VarChar(10)
  accessibilityTextScale String @default("standard") @map("accessibility_text_scale") @db.VarChar(16)
  accessibilityMotion String @default("system") @map("accessibility_motion") @db.VarChar(10)
  accessibilityFocus String @default("standard") @map("accessibility_focus") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId, churchId], references: [id, churchId], onDelete: Restrict)

  @@unique([userId], map: "user_preferences_user_id_key")
  @@unique([userId, churchId], map: "user_preferences_user_id_church_id_key")
  @@unique([id, churchId], map: "user_preferences_id_church_id_key")
  @@index([churchId], map: "user_preferences_church_id_idx")
  @@index([churchId, deletedAt], map: "user_preferences_church_id_deleted_at_idx")
  @@map("user_preferences")
}
