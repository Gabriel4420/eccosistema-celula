# =====================================================================
# Mission Atos - Ecossistema de Células
#
# Copie este arquivo para `.env` e SUBSTITUA todos os valores
# `replace-with-*`. Em produção, `parseAuthenticationEnvironment`
# rejeita placeholders e segredos fracos para impedir deploys inseguros.
# =====================================================================

# ---------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Banco de dados PostgreSQL (DATABASE_URL e TEST_DATABASE_URL devem ser
# bancos distintos; o de teste deve conter "test" no caminho).
DATABASE_URL=postgresql://mission_atos_dev:local_dev_only@localhost:5432/mission_atos_dev?schema=public
TEST_DATABASE_URL=postgresql://mission_atos_test:local_test_only@localhost:55433/mission_atos_test?schema=public

# Igreja raiz do ambiente de autenticação (UUID real).
AUTH_CHURCH_ID=replace-with-a-real-uuid-for-the-root-church

# Segredos: mínimo 32 caracteres, distintos entre si e sem placeholders.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret

# ISS/AUD do JWT (padrões seguros; ajuste se quiser valores próprios).
JWT_ISSUER=mission-atos-api
JWT_AUDIENCE=mission-atos-clients

# Tempo de vida do access token (60-900 segundos) e do refresh token
# em segundos (mín 3600, máx 2_592_000 = 30 dias).
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookie de refresh: deve ser true em produção (forçado pela validação).
# Em desenvolvimento local sob HTTP precisa ser false, senão o navegador
# descarta o cookie e a sessão cai ao expirar o access token.
AUTH_COOKIE_SECURE=false

# Rate limiting de login (por IP e por conta).
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=5

# Origens permitidas no CORS (separadas por vírgula). Inclua a URL
# exata do painel web em produção.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Painel web (Next.js)
# ---------------------------------------------------------------------
# Em desenvolvimento, o fetcher usa direto a API. Em produção usa o
# proxy `/api` do Next.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PROXY_TARGET=http://localhost:3001

# VLibras (tradução para Libras, gratuito). Habilite com "true".
# Sem estar habilitado, o widget não é injetado no painel.
# NEXT_PUBLIC_VLIBRAS_ENABLED=false
# NEXT_PUBLIC_VLIBRAS_SCRIPT_URL=https://vlibras.gov.br/app/vlibras-plugin.js
# NEXT_PUBLIC_VLIBRAS_APP_URL=https://vlibras.gov.br/app

# ---------------------------------------------------------------------
# Bootstrap do ambiente de produção (primeiro acesso)
# Uso: npm run bootstrap --workspace @mission-atos/database
# ---------------------------------------------------------------------
# BOOTSTRAP_CONFIRM=CREATE_INITIAL_ADMIN
# BOOTSTRAP_CHURCH_NAME=Missão Atos
# BOOTSTRAP_CHURCH_SLUG=missao-atos
# BOOTSTRAP_CHURCH_TIMEZONE=America/Sao_Paulo
# BOOTSTRAP_ADMIN_FIRST_NAME=Admin
# BOOTSTRAP_ADMIN_LAST_NAME=Principal
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-com-a-senha-forte-do-admin
