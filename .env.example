# API server configuration
NODE_ENV=development
PORT=3001

# This is intentionally public and may be embedded in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL local-only examples. Replace these outside local development.
DATABASE_URL=postgresql://mission_atos_dev:local_dev_only@localhost:5432/mission_atos_dev?schema=public
TEST_DATABASE_URL=postgresql://mission_atos_test:local_test_only@localhost:55433/mission_atos_test?schema=public

# Authentication placeholders. Replace with secrets outside the repository.
AUTH_CHURCH_ID=00000000-0000-4000-8000-000000000001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=mission-atos-api
JWT_AUDIENCE=mission-atos-clients
JWT_ACCESS_TTL_SECONDS=600
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=5
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Optional local command: npm run deploy:render
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv_replace-me?key=replace-me
