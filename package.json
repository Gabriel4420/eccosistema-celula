{
  "name": "eccosistema-celula",
  "version": "0.0.0",
  "private": true,
  "description": "Fundação técnica do ecossistema de gestão de células.",
  "engines": {
    "node": ">=24.0.0 <26",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:format": "npm run db:format --workspace @mission-atos/database",
    "db:generate": "npm run db:generate --workspace @mission-atos/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @mission-atos/database",
    "db:migrate:status": "npm run db:migrate:status --workspace @mission-atos/database",
    "db:seed": "npm run db:seed --workspace @mission-atos/database",
    "db:validate": "npm run db:validate --workspace @mission-atos/database",
    "deploy:render": "node --env-file-if-exists=.env scripts/deploy-render.mjs",
    "deploy:vercel": "npx --yes vercel@latest --cwd apps/web deploy --prod",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:auth:e2e": "npm run test:auth:e2e --workspace @mission-atos/api",
    "test:auth:integration": "npm run test:integration --workspace @mission-atos/api",
    "test:users:e2e": "npm run test:users:e2e --workspace @mission-atos/api",
    "test:churches:e2e": "npm run test:churches:e2e --workspace @mission-atos/api",
    "test:people:e2e": "npm run test:people:e2e --workspace @mission-atos/api",
    "test:attendance:e2e": "npm run test:attendance:e2e --workspace @mission-atos/api",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "npm run test:integration --workspace @mission-atos/database",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.11",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
