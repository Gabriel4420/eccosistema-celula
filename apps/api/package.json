{
  "name": "@mission-atos/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:auth:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --config jest.e2e.config.cjs",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --config jest.integration.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mission-atos/config": "*",
    "@mission-atos/contracts": "*",
    "@mission-atos/database": "*",
    "@mission-atos/domain": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@mission-atos/eslint-config": "*",
    "@mission-atos/typescript-config": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
