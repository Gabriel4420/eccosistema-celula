{
  "extends": "@mission-atos/typescript-config/expo.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}